MONGO_VERSION=8.0.13

# DNS suffix for manually provisioned records: mongoN.db.<suffix>
MONGO_HORIZON_SUFFIX="env.domain.tld"
MONGO_HORIZON_NAME="external"

STACK_NAME="myapp-mongo-stack"
MONGO_SERVICE_URI=${STACK_NAME}_database
BACKEND_NETWORK_NAME=${STACK_NAME}_backend
BACKEND_NETWORK_SUBNET="10.0.250.0/24"
BACKEND_NETWORK_GATEWAY="10.0.250.1"
REPLICASET_NAME="rs"

MONGO_ROOT_USERNAME="root"
INITDB_DATABASE="myinitdatabase"
INITDB_USER="mydbuser"

# NoSQLClient Web UI port (optional, defaults to 3030)
NOSQLCLIENT_PORT=3030
